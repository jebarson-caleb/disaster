APP_ENV=development
SECRET_KEY=replace-with-an-independent-random-value-of-32-or-more-characters
JWT_SECRET_KEY=replace-with-a-different-random-value-of-32-or-more-characters
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
CORS_ORIGINS=http://localhost:5173
DEMO_MODE=true
AUTO_MIGRATE=true
COOKIE_SECURE=false
RATELIMIT_STORAGE_URI=memory://
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-15-or-more-characters
BOOTSTRAP_ADMIN_NAME=Incident Commander
BOOTSTRAP_ADMIN_PHONE=112
EMERGENCY_HOTLINE=112
ALERT_DELIVERY_WEBHOOK_URL=
ALERT_DELIVERY_WEBHOOK_SECRET=
ALERT_DELIVERY_TIMEOUT_SECONDS=5
DONATION_PAYMENT_URL=
PUBLIC_BASE_URL=http://localhost:5173
PASSWORD_RESET_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=8
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
