APP_ENV=development
SECRET_KEY=replace-with-an-independent-random-value-of-32-or-more-characters
JWT_SECRET_KEY=replace-with-a-different-random-value-of-32-or-more-characters
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
CORS_ORIGINS=http://localhost:5173
DEMO_MODE=true
AUTO_MIGRATE=true
MFA_ENCRYPTION_KEY=replace-with-a-fernet-key-generated-by-the-command-in-docs
MFA_REQUIRED_ROLES=Admin,Police,Fire Service,Hospital,Ambulance,Shelter,NGO
COOKIE_SECURE=false
RATELIMIT_STORAGE_URI=memory://
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-15-or-more-characters
BOOTSTRAP_ADMIN_NAME=Incident Commander
BOOTSTRAP_ADMIN_PHONE=112
EMERGENCY_HOTLINE=112
DONATION_PAYMENT_URL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
